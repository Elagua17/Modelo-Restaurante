# ==============================================================================
# VARIABLES DE ENTORNO - LA CABRERA RESTAURANTE
# Copiá este archivo como '.env' para tu entorno local de desarrollo.
# NUNCA subas tu archivo '.env' con datos sensibles a repositorios públicos.
# ==============================================================================

# PIN de acceso administrativo al panel de cocina (6 dígitos numéricos)
VITE_ADMIN_PIN=123456

# Número de WhatsApp del restaurante (con código de país, ej: 549343XXXXXXX)
VITE_WA_NUMBER=5493430000000

# Coordenadas geográficas del local gastronómico
VITE_STORE_LAT=-31.7408
VITE_STORE_LNG=-60.4893

# Radio máximo de cobertura para envíos a domicilio (en kilómetros)
VITE_MAX_DELIVERY_KM=12

# (Opcional) Conexión a Supabase si se migra de almacenamiento local a nube
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
